# Dependencies (unanchored: every workspace package has its own node_modules)
node_modules/
.pnp
.pnp.*

# Next.js (the app lives in apps/web — unanchored so any app's build output is ignored)
.next/
out/
next-env.d.ts

# Production build
/build

# Testing
/coverage

# Env / secrets — NEVER commit (NDA-binding). Only `.env.example` is tracked.
.env
.env*.local
.env.development
.env.staging
.env.production

# Editor / OS
.DS_Store
*.pem
*.tsbuildinfo

# Claude local settings (personal, per-machine)
.claude/settings.local.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma generated client
/packages/db/src/generated/

# Legacy app (Apps Script backend + monolith client) — LOCAL-ONLY parity reference.
# Never committed: keep it on the dev machine, not in the shared repo.
/legacy/
.vercel
.env*

# Internal-only defense-book study reference (chapters + generator + output, all private).
/internal-docs/

# Turborepo
.turbo

# API build output (apps/api/build.mjs) — an immutable artefact, rebuilt per deploy.
apps/api/dist/
