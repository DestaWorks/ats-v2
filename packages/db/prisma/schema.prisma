// DestaHealth ATS — Prisma schema.
// Wave 0.3 brings ONLY the auth tables (Better Auth models + our `role`) and a minimal
// `access_request` (the request-access screen). Feature tables land in their own waves.
//
// Runtime connects via the Supabase transaction pooler (DATABASE_URL, pg driver adapter);
// migrations use the session pooler (DIRECT_URL, set in prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth core models (+ admin plugin fields) ---

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  // RBAC (DECISIONS D3): one fixed role per account; `admin` is a role value.
  role             String            @default("Associate")
  // admin plugin
  banned           Boolean           @default(false)
  banReason        String?
  banExpires       DateTime?
  // Wave 4.1 (Templates) — per-user profile data, DB-backed (legacy kept both in unscoped/
  // mis-scoped localStorage, see docs/IMPLEMENTATION-PLAN.md Wave 4.1 notes).
  emailSignature   String?
  stickyNote       String?
  // Wave 5.4 (My Profile) — self-service bio/contact fields (legacy `ATS_Profiles` sheet).
  // Avatar reuses the existing Better Auth `image` field above, not a new column.
  bio              String?
  phone            String?
  location         String?
  // Wave 5.4 (Learn tutorial) — per-chapter completion, `{chapterId: isoTimestamp}`. Legacy kept
  // this in unscoped `localStorage` (per-device, not per-user, never synced) — the same class of
  // bug Wave 4.1 already fixed once for signature/sticky-note; fixed the same way here.
  learnProgress    Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  mentions         Mention[]
  targets          DailyTarget[]     @relation("targets")
  actuals          DailyActual[]     @relation("actuals")
  dailyLogs        DailyLog[]        @relation("dailyLogs")
  journalEntries   JournalEntry[]    @relation("journalEntries")
  journalGoals     JournalGoal[]     @relation("journalGoals")
  savedViews       SavedView[]       @relation("savedViews")
  savedIcps        SavedIcp[]        @relation("savedIcps")
  receivedFeedback ManagerFeedback[] @relation("managerFeedback")
  memberships      Membership[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String? // admin plugin
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Better Auth only ever looks this up by identifier (email-verification tokens,
  // reset-password:<token> — see password.mjs findVerificationValue/consumeVerificationValue).
  // Without this, every lookup is a sequential scan of the whole table (perf audit 2026-08-03).
  @@index([identifier])
  @@map("verification")
}

// --- Access requests (request-access screen; full admin CRUD in Wave 5) ---

model AccessRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  message      String?
  status       String   @default("pending") // pending | approved | declined
  createdAt    DateTime @default(now())

  @@index([status])
  @@map("access_request")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Audit trail (Wave 0.5) ---
// Append-only activity log. `before`/`after` snapshots may contain PII/PHI, so reads are
// capability-gated (`viewAuditLog`); rows are written inside the same transaction as the
// mutation they record (see server/db/audit.ts) so the trail can't drift from the data.

model ActivityLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  actor    String // the acting user's id
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([actor, at])
  // Wave 2.5 Activity Log (AL-2): the whole-log `at desc` sort + date-range scans, and the
  // action-filtered sort (action is the highest-selectivity filter). `entity` (~3 values) and
  // `actor`-scoped reads intentionally ride `[at,id]` / the existing `[actor,at]` — keeping
  // write-amplification minimal on this append-only, high-write table.
  @@index([tenantId, at, id])
  @@index([tenantId, action, at, id])
  @@map("activity_log")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AiUsageEvent {
  id        String @id @default(cuid())
  operation String
  provider  String
  model     String
  status    String

  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int

  errorName       String?
  errorStatusCode Int?

  createdAt DateTime @default(now())

  @@index([operation, createdAt])
  @@index([createdAt])
  @@map("ai_usage_event")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Global AI kill switch — single row (id="singleton"), checked on every AI call. Lets an admin
// disable AI app-wide without a redeploy.
model AiSettings {
  id             String   @id
  disabled       Boolean  @default(false)
  disabledReason String?
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  @@map("ai_settings")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// One asynchronous run of the legacy Sheet -> Postgres ETL commit (Phase 5). The row is three
// things at once, and each one is why it exists rather than living in the queue's own payload:
//
//  1. The staged input. The upload is up to 10 MB of CSV plus resume text; carrying that through a
//     queue payload would put a multi-megabyte blob in every retry and every dead-letter record.
//     The job payload is `{ runId }` and reads the input from here.
//  2. The progress marker. `processedRows` is the resume point: an attempt aborted at a row
//     boundary restarts from it instead of redoing minutes of work (and, when `extractWithAi` is
//     on, re-paying for LLM calls). Correctness does not depend on it — `legacy_id` upsert makes a
//     redone row a no-op — so a lost update costs time, never data.
//  3. The operator's answer to "did it finish, and if not where did it stop".
//
// `content`/`resumes` hold candidate PII and are CLEARED the moment the run reaches a terminal
// state, so the staging copy does not outlive the import it existed for.
model MigrationRun {
  id     String  @id @default(cuid())
  jobId  String?
  status String  @default("queued") // queued | running | interrupted | succeeded | failed

  attempt       Int    @default(0)
  processedRows Int    @default(0)
  totalRows     Int    @default(0)
  checksum      String

  format        String
  filename      String?
  extractWithAi Boolean @default(false)
  content       String?
  resumes       Json?

  report      Json?
  failureCode String?

  startedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, createdAt])
  @@index([startedById, createdAt])
  @@map("migration_runs")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Recruiting pipeline (Wave 1.1) ---
// Candidate + Client + StageHistory. Vocabulary enums (credential, status, track, source,
// population, setting, tags, licenseStatus) are stored as String/String[] and validated in
// zod against the `lib/constants` unions (matches `User.role`) — keeps vocab churn out of
// migrations. Status is a stable CODE + numeric `stageOrder` mirror (never the label). Actor
// columns are plain `String` ids (mirrors `activity_log.actor`) — legacy actors may not
// resolve to a `User` row at ETL. Soft-delete (`deletedAt`) is filtered by default at the
// repository layer. `licenseNumber` is sensitive PII — DTO-gated (`viewCredentials`) and
// encrypted at rest at the repository boundary when `FIELD_ENCRYPTION_KEY` is set.

model Client {
  id       String  @id @default(cuid())
  legacyId String? @unique
  name     String
  capacity Int?

  // Wave 4.2 (CRM) — client profile fields (legacy's "Client Info" tab). Legacy persisted these
  // as activity-log events replayed on read (`ats_log crm_update_client`), not real columns —
  // real nullable columns here instead, matching every other wave's replacement of that pattern.
  contact       String? // primary contact NAME (free text) — distinct from the ClientContact table
  location      String?
  priority      String? // HIGH | MED | STANDARD | NEW (free-vocab select, not a DB enum)
  cadence       String? // Weekly | Bi-weekly | Monthly | Quarterly | As needed
  schedule      String?
  contractStart DateTime?
  renewalDate   DateTime?
  states        String[]  @default([])
  specialties   String[]  @default([])
  services      String[]  @default([])

  // Wave 4.2 (CRM, Revenue/Profitability slice) — client-entered inputs for the Revenue tab's
  // ARR/gross-profit computation (legacy's "Revenue Inputs" modal, `index.html:7237-7272`).
  monthlyRate     Int? // monthly retainer $
  avgPlacementFee Int? // $ per placement
  grossMargin     Int? // % margin assumption, 0-100

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  candidates   Candidate[]
  rules        ClientRules? // 1:1 back-relation — per-client scoring/matching rules
  sourceLeads  SourceLead[]        @relation("LeadTargetClient") // pre-pipeline leads targeting this client
  openRoles    OpenRole[] // Wave 3.5 — this client's job requisitions
  matchProfile ClientMatchProfile? // 1:1 back-relation — this client's active-matcher weight overrides
  contacts     ClientContact[] // Wave 4.2 — CRM contacts tracked at this client
  tasks        ClientTask[] // Wave 4.2 slice 2 — CRM follow-up tasks
  meetings     ClientMeeting[] // Wave 4.2 slice 2 — CRM meeting log
  deals        Deal[] // Wave 4.2 slice 3 — CRM sales opportunities
  notes        ClientNote[] // Wave 4.2 (Health Score slice) — manual communication log

  @@index([deletedAt])
  @@map("clients")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 (CRM) — a person tracked at a client (legacy "Contacts" tab, `ATS_ClientContacts`).
/// Soft-delete + `status` ("active"|"left") are separate concerns: a departed contact stays
/// visible (collapsed) until explicitly deleted, matching legacy parity.
model ClientContact {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fullName  String
  title     String?
  role      String  @default("unknown") // decision_maker | gatekeeper | influencer | user | unknown
  email     String?
  phone     String?
  linkedin  String?
  reportsTo String? // free text (legacy parity — not a self-FK; often names someone untracked)
  status    String  @default("active") // active | left
  notes     String?

  addedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  /// Wave 4.3 (Client Portal) — explicit opt-in, separate from just existing as a CRM contact
  /// record (legacy conflated the two: any contact logged for relationship-tracking purposes was
  /// automatically portal-login-eligible). Only contacts with this true can hold a portal token.
  portalEnabled Boolean             @default(false)
  portalTokens  ClientPortalToken[]
  postedRoles   OpenRole[]          @relation("PortalPostedRoles")

  @@index([clientId])
  @@map("client_contacts")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.3 (Client Portal) — a magic-link credential scoped to one `ClientContact`. Only the
/// SHA-256 hash is ever stored (mirrors `field-crypto.ts`'s never-persist-the-usable-secret
/// posture); the raw token is shown to an admin exactly once at generation time. Generating a new
/// token for a contact revokes any prior one (one live link per contact at a time).
model ClientPortalToken {
  id        String        @id @default(cuid())
  contactId String
  contact   ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([contactId])
  @@map("client_portal_tokens")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.3 (Client Portal) — an external, unauthenticated visitor asking for portal access.
/// Deliberately NOT the same model as `AccessRequest` (staff account requests): approving this
/// grants a `ClientContact` a portal token, never one of the 6 internal RBAC roles — conflating
/// the two approval flows would be a real bug, not just a naming clash.
model PortalAccessRequest {
  id                  String   @id @default(cuid())
  name                String
  email               String
  requestedClientName String
  note                String?
  status              String   @default("pending") // pending | approved | declined
  createdAt           DateTime @default(now())

  @@index([status])
  @@map("portal_access_requests")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 slice 2 (CRM) — a follow-up task for a client (legacy "Tasks" tab). Legacy has no real
/// mutable state here at all: "marking done" appends a SECOND independent activity-log row instead
/// of updating anything, so the "Open Tasks" filter never actually shrinks (confirmed by tracing
/// the append/filter logic — a real bug, not a pattern to port). Real `status` + `completedAt`
/// columns here instead.
model ClientTask {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?
  assignedToId String? // free id, not FK-enforced (matches OpenRole.assignedToId)
  status       String    @default("open") // open | done
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@index([clientId])
  @@map("client_tasks")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 slice 2 (CRM) — a logged meeting for a client (legacy "Meetings" tab). Genuinely
/// append-only in legacy (no edit/delete anywhere) — that part of "(activity-based)" IS a real
/// design to preserve, unlike Tasks. Create + soft-delete-for-correction only (mirrors
/// `CandidateNote`'s precedent), no update.
model ClientMeeting {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String // weekly | monthly | qbr | adhoc
  attendees   String?
  notes       String?
  actionItems String?
  loggedById  String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?

  @@index([clientId])
  @@map("client_meetings")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 (CRM, Health Score slice) — a manual call/note log entry (legacy `crm_note`). Fills
/// a real gap: Health Score's "communication recency" factor and the Compare dashboard's "Last
/// Contact" column both need a touch log that isn't a scheduled `ClientMeeting`. Same soft-delete
/// shape as `ClientMeeting` (append + correct-by-delete, no edit).
model ClientNote {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text        String
  loggedById  String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?

  @@index([clientId])
  @@map("client_notes")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 slice 3 (CRM) — a sales opportunity for a client (legacy "Deals" tab, DROP 76).
/// `stage` drives the kanban column (5 open stages + Signed/Lost, see `DEAL_STAGES`). No computed
/// close-probability here — legacy's formula needs Gmail-synced sentiment data this app doesn't
/// have yet (confirmed by reading `dealProbability()`); `probabilityOverride` is legacy's own
/// manual-only escape hatch, ported as-is. `name` collapses legacy's redundant `PracticeName` +
/// `ClientName` string pair now that a real `clientId` FK exists.
model Deal {
  id                  String        @id @default(cuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  stage               String        @default("Lead") // Lead|Contacted|Meeting|Proposal|Negotiation|Signed|Lost
  estValue            Int?
  expectedCloseDate   DateTime?
  probabilityOverride Int? // 0-100, manual only
  closedAt            DateTime?
  closeReason         String?
  postMortem          String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  deletedById         String?
  blockers            DealBlocker[]

  @@index([clientId])
  @@map("deals")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Wave 4.2 slice 3 (CRM) — a real table (legacy's `Deal.Blockers` is a JSON-string blob, not a
/// table at all, despite the plan doc calling for a `deal_blockers` model). Same `text`/`resolved`
/// shape as the JSON entries — no severity/category, legacy never had them. Hard-deletable (a
/// small checklist item; `resolved` already captures the audit-worthy state).
model DealBlocker {
  id         String    @id @default(cuid())
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text       String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([dealId])
  @@map("deal_blockers")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Per-client scoring/matching rules — DATA, not code (DECISIONS: scoring rules live in a table,
/// consumed by the pure `scoreCandidate(candidate, clientRules)` / `getAutoDisqualify`). Exactly one
/// row per Client (1:1); deleting a Client cascades its rules. Empty arrays mean "no constraint on
/// this dimension" (that dimension contributes nothing to `max`). Editing UI is a later (CRM) wave;
/// seeded from `BASE_CLIENT_RULES` for now.
model ClientRules {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  states         String[] @default([]) // e.g. ["CT","NJ"] — matched against candidate.licenseState
  creds          String[] @default([]) // e.g. ["PMHNP","MD"] — matched against candidate.credential
  pops           String[] @default([]) // populations, e.g. ["Child/Adolescent"]
  settings       String[] @default([]) // e.g. ["Hybrid","Outpatient"]
  schedule       String? // e.g. "Hybrid", "3x12hr shifts", "Flexible" — Screening schedule-match input
  priority       String? // "HIGH" | "MED" | "STANDARD" (display / future weighting)
  autoDisqualify String[] @default([]) // human-readable hard-DQ reasons (feeds getAutoDisqualify context)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@map("client_rules")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Candidate {
  id                  String               @id @default(cuid())
  legacyId            String?              @unique
  // identity / contact (PII)
  name                String
  email               String?
  phone               String?
  city                String?
  state               String?
  targetLocation      String? // legacy TargetLocation — comma-joined free text, outreach-template interpolation only
  employer            String?
  yearsExp            Int?
  // clinical profile (scoring/gate inputs)
  credential          String?
  population          String?
  setting             String?
  telehealthPref      String? // legacy TelehealthPref — preference, distinct from setting
  track               String               @default("Clinical")
  source              String?
  tags                String[]             @default([])
  outreachAttempts    Int                  @default(0)
  // license / verification
  licenseState        String?
  licenseNumber       String? // SENSITIVE — DTO-gated + encrypted at rest when FIELD_ENCRYPTION_KEY is set
  licenseStatus       String               @default("Not Verified")
  licenseExpiry       DateTime?
  licenseVerifiedAt   DateTime?
  licenseVerifiedById String?
  // pipeline (code + ordinal + denormalized timing)
  status              String               @default("NEW_CANDIDATE")
  stageOrder          Int                  @default(0)
  stageEnteredAt      DateTime             @default(now())
  placedAt            DateTime?
  // client
  clientId            String?
  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Wave 3.5: which Open Role this candidate was promoted to fill, if any. A DELIBERATE deviation
  // from legacy (`Code.gs:860`), which stuffed `"FilledFromRole:R123"` into the free-text `tags`
  // string with no real FK — this is a real, nullable relation instead. `onDelete: SetNull` so
  // deleting a role never takes a placed candidate's history with it.
  filledFromRoleId    String?
  filledFromRole      OpenRole?            @relation(fields: [filledFromRoleId], references: [id], onDelete: SetNull)
  // lifecycle
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  deletedById         String?
  stageHistory        StageHistory[]
  documents           Document[]
  notes               CandidateNote[]
  scorecards          ScreeningScorecard[]
  // Sourcing (Wave 2.6) back-relations. `promotedFromLead` is the lead this candidate was promoted
  // FROM (0/1, `@unique` on the lead side); `outreachLog` is the shared outreach table (candidate
  // side is written later — the `outreachAttempts` Int column above is the DENORM count, not this).
  promotedFromLead    SourceLead?          @relation("LeadPromotion")
  outreachLog         OutreachAttempt[]

  @@index([status])
  @@index([clientId])
  @@index([filledFromRoleId])
  @@index([deletedAt])
  @@index([licenseExpiry])
  @@index([status, deletedAt])
  @@index([email])
  // Keyset pagination (search-pagination wave). Composite indexes serve the (where..., orderBy)
  // tuples of the list + board keyset queries so deep pages stay O(page), not a growing scan.
  @@index([tenantId, deletedAt, createdAt, id]) // list, createdAt sorts (Newest/Oldest)
  @@index([tenantId, status, deletedAt, createdAt, id]) // board per-column keyset (status + createdAt desc, id)
  @@index([tenantId, status, deletedAt, stageEnteredAt]) // stuck/overdue thresholds + listStaleActive
  // Perf audit 2026-08-03: candidate.repository.ts's search does `name`/`email` `contains`
  // (case-insensitive) — a plain btree (the `email` index above) can only accelerate PREFIX
  // matches, never substring search, so every keystroke was a sequential scan of the whole table.
  // Fixed with two pg_trgm GIN indexes (candidates_name_trgm_idx, candidates_email_trgm_idx) —
  // hand-written raw SQL in prisma/migrations/…_add_pg_trgm_candidate_search_indexes/, NOT
  // declared here: this DB (Supabase-managed) already has extensions Prisma never tracked
  // (pgcrypto, uuid-ossp, …) — turning on the `postgresqlExtensions` preview feature to declare
  // `pg_trgm` in the datasource block makes Prisma try to reconcile ALL of them against migration
  // history, which it can only do via a full schema reset. Not worth that risk for one extension.
  @@map("candidates")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Uploaded documents (resumes today; licenses/other later). Wave 1.2 (design S-1/S-2):
// stores metadata + client-extracted text + captured structured JSON. Physical PDF bytes are
// deferred to Wave 6 — `storageKey` stays null until the Supabase bucket is wired.
model Document {
  id       String  @id @default(cuid())
  legacyId String? @unique // ETL upsert (legacy ResumeFileID)

  // ownership — NULLABLE: a doc can exist pre-match (uploaded, not yet attached).
  // Cascade: a resume is pure candidate PII — a hard purge takes its documents with it.
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // classification (validated vs DOCUMENT_TYPES in zod; stored as String)
  type             String @default("resume")
  originalFilename String
  mimeType         String
  sizeBytes        Int?

  // storage references (S-2)
  storageKey String? // Supabase object path — NULL until Wave 6
  legacyUrl  String? // legacy Google Drive URL, carried at ETL

  // captured extraction (SENSITIVE — DTO-gated on viewCredentials; never logged; encrypted at
  // rest at the repository boundary when FIELD_ENCRYPTION_KEY is set)
  extractedText String?
  extractedData Json?

  // lifecycle
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@index([candidateId])
  @@index([deletedAt])
  @@index([type])
  @@map("documents")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Candidate notes (Wave 2.2). Body is user text — stored RAW and rendered as escaped plain text
// client-side (NEVER dangerouslySetInnerHTML — fixes the legacy stored-XSS). noteType is a two-value
// vocab (internal | external) validated in zod. Role-scoped visibility is enforced SERVER-SIDE in the
// read (server/services/note.service.ts), never shipped-then-hidden. Cascade: a note is candidate PII,
// so a hard purge takes its notes with it.
model CandidateNote {
  id          String    @id @default(cuid())
  legacyId    String?   @unique // deferred ETL backfill (idempotent upsert)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  authorId   String // acting user's id (mirrors activity_log.actor)
  authorName String? // denormalized display name (legacy notes may lack a User row)
  body       String // RAW user text — never rendered as HTML
  noteType   String  @default("internal") // internal | external (validated vs constant union in zod)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  mentions Mention[]

  @@index([candidateId])
  @@index([candidateId, createdAt])
  @@index([deletedAt])
  @@map("candidate_notes")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// One @mention notification: note author tagged `recipient` in a candidate note. Created
// SERVER-SIDE by re-parsing the stored body (never a client-supplied recipient list — the legacy
// `ats_notify_mention` trusted the client). `readAt` is the read state the bell/alerts panel keys
// off (DATA-MODEL "mentions(recipient, read)"). `candidateId` is denormalized for the deep link.
model Mention {
  id     String        @id @default(cuid())
  noteId String
  note   CandidateNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  candidateId String
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@map("mentions")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model StageHistory {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStatus     String?
  toStatus       String
  fromStageOrder Int?
  toStageOrder   Int
  enteredAt      DateTime  @default(now())
  actorId        String

  @@index([candidateId])
  @@index([candidateId, enteredAt])
  // Perf audit 2026-08-03: maxStageOrderAsOf (5 report endpoints) filters enteredAt/toStageOrder
  // and groups by candidateId, across ALL candidates — the two indexes above are candidateId-
  // leading (a per-candidate lookup shape) and don't help a cross-candidate scan. This one covers
  // the WHERE + the grouped column, enabling an index-only scan.
  @@index([enteredAt, toStageOrder, candidateId])
  @@map("stage_history")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Screening scorecard (Wave 3.3, legacy/index.html:6689-6928). One row PER SCORING EVENT
/// (append-only, like StageHistory — a candidate can be re-screened), not an upsert. All raw
/// inputs are SCREENING-TIME data — legacy never read/wrote these to the candidate profile (its
/// own inputs reset to blank on every candidate select, even years-of-experience despite
/// Candidate.yearsExp existing) — nothing here syncs back to Candidate.
model ScreeningScorecard {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  clientId    String? // denormalized: which client's rules were used at scoring time

  credentialsHeld String[] @default([])
  statesHeld      String[] @default([])
  yearsExp        Int?
  schedule        String?
  salaryAsk       Int?
  commChecklist   String[] @default([])

  // computed + persisted (history/reporting doesn't need to re-run against a since-changed ClientRules row)
  credScore     Int
  stateScore    Int
  expScore      Int
  scheduleScore Int
  salaryScore   Int
  commScore     Int
  totalPct      Int
  decision      String // "Advance" | "Conditional" | "Hold"

  notes String?

  scoredById String
  scoredAt   DateTime @default(now())

  @@index([candidateId, scoredAt])
  @@map("screening_scorecards")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Sourcing (Wave 2.6) ---
// Pre-pipeline lead funnel. `status` is the canonical LeadStatus LABEL (L-1), validated in zod vs
// LEAD_STATUSES and canonicalized with `normalizeLeadStatus` on write — no numeric stage code
// (leads have no gates/ordinal funnel). Vocab (source/credential/state/tags) is FREE TEXT here, not
// the candidate strict-vocab enums — the promote mapper coerces to the enums (dropping non-matches).
// Promote creates a Candidate in Postgres (D2) and back-links it (`promotedCandidateId @unique`).
model SourceLead {
  id       String  @id @default(cuid())
  legacyId String? @unique // deferred ETL backfill (idempotent upsert)

  // identity / contact (PII)
  name        String
  email       String?
  phone       String?
  linkedinUrl String?
  npi         String? @unique // National Provider Identifier (NPPES) — Discover sourcing dedupe key

  // sourcing context (free text — NOT the candidate strict-vocab enums)
  credential String? // raw job title / credential text
  state      String?
  source     String?
  tags       String[] @default([])
  notes      String?

  // target client (optional) — reuses the small clients table for the promote → candidate.clientId carry
  clientId String?
  client   Client? @relation("LeadTargetClient", fields: [clientId], references: [id], onDelete: SetNull)

  // lifecycle status + denormalized outreach (L-4)
  status              String    @default("Sourced") // a LeadStatus LABEL
  outreachCount       Int       @default(0) // TRUE attempt count (unbounded; status caps at O3)
  lastOutreachAt      DateTime?
  // Channel of the newest attempt (denorm, kept by logOutreach + syncOutreachDenorm) — the
  // inventory's legacy "Last touch" cell ("LinkedIn · 20d") without an N+1 latest-attempt read.
  lastOutreachChannel String?
  respondedAt         DateTime?
  // Snooze: excluded from stuck-lead alerts until this date (legacy `SnoozedUntil`). Date-aware
  // EVERYWHERE (the legacy brief checked raw truthiness — an expired snooze suppressed forever).
  snoozedUntil        DateTime?

  // promote back-link (set once, on promote)
  promotedCandidateId String?    @unique
  promotedCandidate   Candidate? @relation("LeadPromotion", fields: [promotedCandidateId], references: [id], onDelete: SetNull)

  // lifecycle
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  outreachAttempts OutreachAttempt[]

  @@index([status])
  @@index([deletedAt])
  @@index([email]) // dedupe/search
  @@index([clientId])
  @@index([tenantId, deletedAt, createdAt, id]) // keyset list (createdAt_desc, id tiebreak)
  @@map("source_leads")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ONE table for BOTH lead and candidate outreach (L-3). This slice writes leadId only; candidateId
// exists for candidate_log_outreach later (no migration then). Cascade on both FKs: an attempt is a
// child of whichever entity owns it and is destroyed with a hard purge of that parent.
model OutreachAttempt {
  id       String  @id @default(cuid())
  legacyId String? @unique // deferred ETL (splits the legacy OutreachAttempts JSON blob into rows)

  leadId String?
  lead   SourceLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  channel String // email | phone | linkedin | other (validated vs OUTREACH_CHANNELS in zod)
  at      DateTime @default(now())
  note    String?
  actorId String

  // Wave 4.1 (Templates) — templateId is a key into the TEMPLATES constant
  // (src/lib/constants/templates.ts), NOT a DB foreign key (templates aren't a DB table).
  // response/respondedAt drive Template Performance's response-rate math; set automatically by
  // leadService.respond() (Hot/Cold) on the most recent unresponded attempt, or manually via the
  // outreach-attempt edit path.
  templateId  String?
  response    String?
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([candidateId])
  @@index([actorId, at]) // DECISIONS: outreach_attempts(actor, day) — the CRM/daily-log perf index
  // Perf audit 2026-08-03: daily.repository.ts's outreachCountsByRange/responseCountsByRange
  // groupBy ACROSS all actors, filtered only by date — [actorId, at] above doesn't help there
  // (actorId isn't in the WHERE), so both ran an unindexed scan of the whole table. These serve
  // that shape (date-range filter leading, actorId second for the groupBy).
  @@index([at, actorId])
  @@index([respondedAt, actorId])
  @@index([templateId])
  @@map("outreach_attempts")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Daily accountability loop (Wave 3.1) ---
// Legacy split this across ATS_DailyTargets/ATS_DailyActuals (keyed by fragile synthesized
// emails) and `ats_log` activity rows with JSON in overloaded columns. Here: real tables keyed
// by (userId, date) where `date`/`weekStart` are CALENDAR-DATE STRINGS ("YYYY-MM-DD", the
// user's local day / Monday of the ISO week) — one week definition app-wide (legacy had three).

/// Manager-set per-associate targets for one day (legacy ATS_DailyTargets).
model DailyTarget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("targets", fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"

  sourcing   Int @default(0)
  outreach   Int @default(0)
  atsCleanup Int @default(0)
  inbound    Int @default(0)
  screens    Int @default(0)

  priorityClientId   String?
  priorityRole       String?
  priorityState      String?
  notesFromYesterday String?
  watchFor           String?

  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("daily_targets")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// End-of-shift self-confirmed actuals (legacy ATS_DailyActuals; pre-filled from live counts).
model DailyActual {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("actuals", fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"

  sourcing   Int @default(0)
  outreach   Int @default(0)
  atsCleanup Int @default(0)
  inbound    Int @default(0)
  screens    Int @default(0)

  note              String?
  perClientSourcing Json? // { [clientId]: count } — optional breakdown
  shiftHandoff      String? // visible to the next shift

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("daily_actuals")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Daily Log self-report (legacy `ats_log` action "daily_log" — JSON in Details). One per user/day.
model DailyLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("dailyLogs", fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"

  sourced    Int @default(0)
  outreach   Int @default(0)
  responses  Int @default(0)
  screenings Int @default(0)
  submitted  Int @default(0)

  blocker      String?
  notes        String?
  shiftHandoff String?
  // Auto-captured snapshot at submit time (added/moved/notes counts from the ATS).
  autoAdded    Int     @default(0)
  autoMoved    Int     @default(0)
  autoNotes    Int     @default(0)
  perClient    Json? // { [clientId]: sourcedCount }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@map("daily_logs")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Journal free-text note (legacy `journal_entry` activity rows).
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("journalEntries", fields: [userId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  text      String
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("journal_entries")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Weekly goal (legacy `journal_goal` rows — which APPENDED a duplicate on toggle; here `done`
/// is a real update). `weekStart` = Monday of the ISO week ("YYYY-MM-DD").
model JournalGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("journalGoals", fields: [userId], references: [id], onDelete: Cascade)
  weekStart String // "YYYY-MM-DD" (Monday)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, weekStart])
  @@map("journal_goals")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Manager → associate feedback note on the Daily Log page (Wave 3.1 backlog, legacy `mgr_feedback`
/// — which repurposed `CandidateName` to hold the target associate's name; a real column here
/// instead). Append-only (no soft-delete — mirrors `JournalEntry`, not `CandidateNote`). `authorId`
/// is a plain actor column (mirrors `DailyTarget.setById`), never the relation side; `targetUserId`
/// is the real FK (mirrors `DailyTarget.userId`) since the recipient's own page reads by it.
model ManagerFeedback {
  id           String   @id @default(cuid())
  authorId     String
  authorName   String? // denormalized display name (mirrors CandidateNote.authorName)
  targetUserId String
  targetUser   User     @relation("managerFeedback", fields: [targetUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@map("manager_feedback")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Per-user saved filter/view (Wave 2.1 closeout; DECISIONS: shareable filters/saved-views → URL
// searchParams + this table, never localStorage — legacy stored these in
// `localStorage["desta_ats_pipeline_views_"+userId]`). Personal-only, no sharing — mirrors
// DailyTarget/JournalGoal (hard delete, no `deletedAt`), not CandidateNote/RoleNote (no other
// user ever reads this row). `scope` discriminates pages with incompatible URL param sets
// (pipeline vs. candidates) so they never collide. `query` is the RAW
// `URLSearchParams.toString()` (no leading "?") — never a structured/parsed shape, so new filter
// params on either page's toolbar need no migration here.
model SavedView {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("savedViews", fields: [userId], references: [id], onDelete: Cascade)

  scope String // "pipeline" | "candidates" (SAVED_VIEW_SCOPES, validated in zod)
  name  String // display name, e.g. "My hot CT leads"
  query String // raw searchParams string, e.g. "track=RN&mine=1&overdue=1"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, name])
  @@index([userId, scope])
  @@map("saved_views")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Open Roles (Wave 3.5, legacy `ATS_OpenRoles` / `ATS_RoleNotes` / `ATS_ClientMatchProfiles`) ---
// A client job requisition, with a client-tunable lead matcher, a fixed-weight dormant-lead
// re-engagement scorer, and a triage-strip ranker (all pure logic in `lib/rules/role-matching.ts`
// — this table is DATA only). Vocab (status/priority) is String, validated in zod against
// `lib/constants/open-role.ts` (matches every other status/vocab column in this schema). Hard
// delete (no soft-delete) — matches legacy `open_role_delete`, which has no undo.

model OpenRole {
  id       String  @id @default(cuid())
  legacyId String? @unique // deferred ETL backfill

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  credential  String?
  state       String?
  city        String?
  setting     String?
  population  String?
  rate        String? // free text, e.g. "$75-90/hr" (legacy stores no structured min/max)
  description String?

  status   String @default("Open") // Open | On Hold | Filled | Closed
  priority String @default("P2") // P1 | P2 | P3

  assignedToId String? // recruiter working this role (free `User.id`, mirrors other actor columns)

  openedAt DateTime  @default(now())
  closedAt DateTime? // set when status flips to Filled/Closed; cleared if reopened

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Wave 4.3 (Client Portal) — set when this role was submitted via `portal_post_role`, distinct
  /// from `createdById` (a free `User.id` string for STAFF-authored roles). A real FK (unlike
  /// `createdById`) since `ClientContact` lives fully in this schema; `SetNull` so revoking/
  /// deleting the contact never cascade-deletes the role.
  postedByContactId String?
  postedByContact   ClientContact? @relation("PortalPostedRoles", fields: [postedByContactId], references: [id], onDelete: SetNull)

  notes            RoleNote[]
  filledCandidates Candidate[]

  @@index([clientId])
  @@index([status])
  @@index([status, priority])
  @@map("open_roles")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Role-scoped note (legacy `ATS_RoleNotes`) — same soft-delete append-only shape as candidate/lead
/// notes, but `category` is free text (legacy default "General") instead of the internal/external vocab.
model RoleNote {
  id     String   @id @default(cuid())
  roleId String
  role   OpenRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  authorId   String
  authorName String?
  category   String  @default("General")
  body       String

  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?

  @@index([roleId])
  @@index([roleId, createdAt])
  @@map("role_notes")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Per-client weight overrides for the ACTIVE lead→role matcher (legacy `ATS_ClientMatchProfiles`,
/// `cpHeaders`). Exactly one row per Client (1:1, upsert-on-save); a client with no row falls back to
/// `DEFAULT_MATCH_WEIGHTS` in `lib/rules/role-matching.ts`. The dormant re-engagement scorer does NOT
/// read this table — it is fixed-weight by design (legacy `scoreMatchDormant`).
model ClientMatchProfile {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  weightSameClient   Int @default(30)
  weightSameState    Int @default(25)
  weightCredExact    Int @default(25)
  weightCredPartial  Int @default(15)
  weightRespondedHot Int @default(20)
  weightOutreach     Int @default(10)
  weightSourced      Int @default(5)
  penaltyCold        Int @default(10)
  minScore           Int @default(25)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("client_match_profiles")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Briefs (Wave 5.1, legacy `Daily_Briefs`/`Weekly_Briefs` sheets) ---
// One row per period (team-wide operational document, not per-user — `savedById` is
// attribution only, matching legacy's `SavedBy` column). Stores the AI's STRUCTURED output
// (not a flattened text blob like legacy) so a saved brief can actually be redisplayed later —
// legacy's archive only ever restored the manual input fields, never the brief content itself.

/// Daily Brief (legacy `daily_brief_generate`/`daily_brief_save`).
model DailyBrief {
  id   String @id @default(cuid())
  date String @unique // "YYYY-MM-DD"

  headline       String?
  exceptions     Json? // string[]
  yesterdayCheck Json?
  clientCards    Json?
  perAssociate   Json?
  teamPulse      String?

  priorityClientId String?
  shiftA           String?
  shiftB           String?
  watchItems       String?

  /// Phase 5: the AI draft the generate JOB produced, waiting to be reviewed and saved.
  /// Kept in its OWN columns rather than written over the fields above, because generation is no
  /// longer part of the request that saves: a job finishing must never overwrite a brief a human
  /// already edited and saved for the same day.
  draft   Json?
  draftAt DateTime?

  savedById String?
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("daily_briefs")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Weekly Brief (legacy `weekly_brief_generate`/`weekly_brief_save`). Patterns are generate-only,
/// never persisted (matches legacy — `weekly_brief_patterns` output was never saved either).
model WeeklyBrief {
  id        String @id @default(cuid())
  weekStart String @unique // "YYYY-MM-DD", Monday of the ISO week (mondayOf)

  headline      String?
  kpiNarrative  String?
  clientCards   Json?
  perAssociate  Json?
  lastWeekCheck Json?
  decisions     Json?

  highlights         String?
  blockers           String?
  nextWeekPriorities String?

  statsSnapshot Json? // raw stats the brief was generated from — audit trail, not redisplayed

  /// Phase 5 — see `DailyBrief.draft` for why the job's output has its own columns.
  draft   Json?
  draftAt DateTime?

  savedById String?
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("weekly_briefs")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Client Discovery (new domain, core slice — perf/security audit branch predates this;
// see docs/DATA-MODEL.md "Prospect (Client Discovery)") ---
// B2B prospecting: search NPPES for practices, track them through a BD pipeline toward becoming
// a real Client. Same shape as SourceLead (external entity -> status pipeline -> soft delete).
// `ownerId`/`createdById` are free `User.id` strings, NOT FK-enforced — matches every other
// actor-tracking column in this schema (OpenRole.assignedToId, SourceLead.createdById); the
// record should survive if that user account is later removed.
model Prospect {
  id String @id @default(cuid())

  practiceName String
  npi          String? @unique // org NPI from NPPES — dedupe key
  taxonomy     String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  website      String?

  status  String  @default("Fresh Lead") // a ProspectStatus LABEL, validated in zod
  ownerId String? // free id, not FK-enforced (matches OpenRole.assignedToId)
  notes   String?
  source  String  @default("NPPES Search") // "NPPES Search" | "Manual"

  icpId String?
  icp   SavedIcp? @relation(fields: [icpId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  contacts ProspectContact[]

  @@index([status])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([tenantId, deletedAt, createdAt, id]) // keyset list (createdAt_desc, id tiebreak)
  @@map("prospects")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ProspectContact {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  fullName    String
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?
  seniority   String?
  source      String  @default("Manual") // "Apollo" | "Hunter" | "Manual"
  notes       String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([prospectId])
  @@map("prospect_contacts")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// A reusable, structured NPPES search — deliberately NOT the generic SavedView mechanism, whose
// `query` column stores an opaque raw querystring re-applied client-side only. An ICP's filter
// fields are stored as real columns so it can be safely re-executed server-side later (e.g. a
// future auto-discovery job), matching SavedView's per-user ownership/cascade shape otherwise.
model SavedIcp {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("savedIcps", fields: [userId], references: [id], onDelete: Cascade)

  name      String
  taxonomy  String?
  state     String?
  city      String?
  zip       String?
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())

  prospects Prospect[]

  @@unique([userId, name])
  @@index([userId])
  @@map("saved_icps")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- Background jobs (Phase 5) ---

/// One occurrence of one schedule, claimed by exactly one worker.
///
/// This row IS the single-fire guarantee. Every worker derives the same occurrence instant from
/// the same schedule definition, so they all race to insert the same `(schedule, occurrenceAt)`
/// pair and the unique index lets exactly one of them win; the losers see a P2002 and stand down.
/// Deliberately not delegated to the queue driver's own "singleton" support: that only collapses
/// jobs still pending, so a fast job that finishes between two workers' ticks would run twice.
model ScheduleRun {
  id           String   @id @default(cuid())
  schedule     String
  occurrenceAt DateTime
  claimedAt    DateTime @default(now())

  @@unique([schedule, occurrenceAt])
  @@map("schedule_runs")
}

/// A CSV export a user asked for, and where the finished file went.
///
/// The bytes live in object storage (D8 — no file bytes in the database); this row holds only the
/// storage key, so a download URL is minted fresh and short-lived per request and no URL that
/// reaches PII is ever persisted. `requestedById` is the only account allowed to read it back.
model ReportExport {
  id            String @id @default(cuid())
  requestedById String

  /// The `ReportFilters` the cohort is built from — re-validated, never trusted, on dequeue.
  filters Json

  /// pending | ready | failed
  status     String  @default("pending")
  storageKey String?
  byteSize   Int?
  /// The `AppError` code of the final failure. A code — never a message, never row data.
  errorCode  String?

  createdAt DateTime  @default(now())
  readyAt   DateTime?

  @@index([requestedById, createdAt(sort: Desc)])
  @@map("report_exports")

  /// Tenant scope. Nullable in 6.1 so the expand migration is safe against live rows. 6.2 backfills
  /// it and `20260829112500_tenants_contract` makes the COLUMN NOT NULL; the `?` here outlives that
  /// migration on purpose and is removed with 6.3 — see the note on `Tenant`.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A customer of the platform. Every tenant-scoped row hangs off exactly one of these, and the
/// enforcement seam in `db(ctx, tx)` is what makes that true without a repository having to
/// remember it.
///
/// PENDING, and deliberately so: `20260829112500_tenants_contract` makes `tenantId` NOT NULL and
/// re-keys thirteen uniqueness rules per tenant, but this file still declares `tenantId String?`
/// and the field-level `@unique`s. That is not drift left by accident — it is a phase ordering the
/// plan did not anticipate, recorded in SAAS-RESTRUCTURE-PLAN 6.2/6.3:
///
///   - `tenantId String` makes `tenantId` a REQUIRED key of every generated create input. 65 call
///     sites across `application` and `db` build those inputs today, and not one of them can name
///     a tenant until 6.3 threads `TenantContext` through the repositories.
///   - Replacing `legacyId @unique` with `@@unique([tenantId, legacyId])` changes the generated
///     WHERE type from `{ legacyId }` to `{ tenantId_legacyId: { tenantId, legacyId } }`, which
///     every `findUnique`/`upsert` on those keys must then supply — the same missing value.
///
/// Both edits are one line each and both are blocked on the same thing, so they ship WITH 6.3's
/// threading, in a commit that can compile. The SQL lands first because the SQL is what actually
/// runs, and because 6.1 already put this file ahead of the migrations in the other direction.
/// The index changes below DID land here: an index carries no type.
model Tenant {
  id          String    @id @default(cuid())
  /// URL / subdomain key.
  slug        String    @unique
  name        String
  /// active | suspended | trial
  status      String    @default("active")
  plan        String    @default("trial")
  seatLimit   Int?
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members Membership[]
  accessRequests          AccessRequest[]
  activityLogs            ActivityLog[]
  aiSettingss             AiSettings[]
  aiUsageEvents           AiUsageEvent[]
  candidates              Candidate[]
  candidateNotes          CandidateNote[]
  clients                 Client[]
  clientContacts          ClientContact[]
  clientMatchProfiles     ClientMatchProfile[]
  clientMeetings          ClientMeeting[]
  clientNotes             ClientNote[]
  clientPortalTokens      ClientPortalToken[]
  clientRuless            ClientRules[]
  clientTasks             ClientTask[]
  dailyActuals            DailyActual[]
  dailyBriefs             DailyBrief[]
  dailyLogs               DailyLog[]
  dailyTargets            DailyTarget[]
  deals                   Deal[]
  dealBlockers            DealBlocker[]
  documents               Document[]
  journalEntrys           JournalEntry[]
  journalGoals            JournalGoal[]
  managerFeedbacks        ManagerFeedback[]
  mentions                Mention[]
  migrationRuns           MigrationRun[]
  openRoles               OpenRole[]
  outreachAttempts        OutreachAttempt[]
  portalAccessRequests    PortalAccessRequest[]
  prospects               Prospect[]
  prospectContacts        ProspectContact[]
  reportExports           ReportExport[]
  roleNotes               RoleNote[]
  savedIcps               SavedIcp[]
  savedViews              SavedView[]
  screeningScorecards     ScreeningScorecard[]
  sourceLeads             SourceLead[]
  stageHistorys           StageHistory[]
  weeklyBriefs            WeeklyBrief[]

  @@map("tenants")
}

/// One person's place in one tenant. Role lives HERE, not on `User`: the same human may be Owner
/// of one tenant and Associate of another, which a column on the user cannot express.
model Membership {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   String @default("Associate")
  /// active | invited | removed
  status String @default("active")

  invitedById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}
