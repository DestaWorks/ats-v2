{
  "name": "desta-ats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "admin:build": "next build apps/admin",
    "api:build": "tsc --noEmit -p apps/api",
    "app:arch-check": "node scripts/check-architecture.mjs",
    "app:auth-check": "node scripts/check-auth-surface.mjs",
    "app:build": "next build apps/web",
    "app:deps-check": "node scripts/check-dependency-drift.mjs",
    "app:license-check": "node scripts/check-licenses.mjs",
    "app:lint": "eslint .",
    "app:raw-index-check": "node scripts/check-raw-sql-indexes.mjs",
    "app:rls-check": "node scripts/check-rls-coverage.mjs",
    "app:runtime-check": "node scripts/check-runtime-manifest.mjs",
    "app:tenant-check": "node scripts/check-tenant-scope.mjs",
    "app:test": "vitest run",
    "app:test-contract": "vitest run packages/contracts/src/route-contract.test.ts",
    "app:test-isolation": "node scripts/isolation-db.mjs",
    "app:test-logs": "vitest run packages/config/src/logger/no-pii-in-logs.test.ts",
    "app:typecheck": "tsc --noEmit && tsc --noEmit -p apps/api",
    "app:test-e2e": "playwright test",
    "arch:check": "turbo run //#app:arch-check",
    "auth:check": "turbo run //#app:auth-check",
    "build": "turbo run //#app:build",
    "build:admin": "turbo run //#admin:build",
    "build:api": "pnpm --filter @destaworks/api build",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-owner.ts",
    "db:seed:clients": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-clients.ts",
    "db:seed:demo": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-demo.ts",
    "db:seed:rules": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-rules.ts",
    "db:status": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-status.ts",
    "db:studio": "prisma studio",
    "deps:check": "turbo run //#app:deps-check",
    "dev": "next dev apps/web",
    "dev:admin": "next dev apps/admin",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "next dev apps/web --port 3007",
    "dev:worker": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/worker.ts",
    "docker:down": "ENV_FILE=${ENV_FILE:-.env.docker.local} docker compose --env-file ${ENV_FILE:-.env.docker.local} down",
    "docker:logs": "ENV_FILE=${ENV_FILE:-.env.docker.local} docker compose --env-file ${ENV_FILE:-.env.docker.local} logs -f",
    "docker:migrate": "ENV_FILE=${ENV_FILE:-.env.docker.local} docker compose --env-file ${ENV_FILE:-.env.docker.local} --profile migrate run --rm migrate",
    "docker:ps": "ENV_FILE=${ENV_FILE:-.env.docker.local} docker compose --env-file ${ENV_FILE:-.env.docker.local} ps",
    "docker:up": "ENV_FILE=${ENV_FILE:-.env.docker.local} docker compose --env-file ${ENV_FILE:-.env.docker.local} up -d --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jobs": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/jobs-cli.ts",
    "license:check": "turbo run //#app:license-check",
    "license:sbom": "node scripts/check-licenses.mjs --write",
    "lint": "turbo run //#app:lint",
    "prepare": "husky",
    "raw-index:check": "turbo run //#app:raw-index-check",
    "rls:check": "turbo run //#app:rls-check",
    "runtime:check": "turbo run //#app:runtime-check",
    "runtime:manifest": "node scripts/runtime-manifest.mjs apps/api/runtime && node scripts/runtime-manifest.mjs --migrate apps/api/runtime-migrate",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "start": "next start apps/web",
    "start:admin": "next start apps/admin",
    "start:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "start:web": "next start apps/web --port 3007",
    "start:worker": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/worker.ts",
    "tenant:check": "turbo run //#app:tenant-check",
    "tenant:reconcile": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-tenant-reconciliation.ts",
    "test": "turbo run //#app:test",
    "test:contract": "turbo run //#app:test-contract",
    "test:e2e": "turbo run //#app:test-e2e",
    "test:isolation": "turbo run //#app:test-isolation",
    "test:logs": "turbo run //#app:test-logs",
    "test:watch": "vitest",
    "typecheck": "turbo run //#app:typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.51.1",
    "@destaworks/application": "workspace:*",
    "@destaworks/auth": "workspace:*",
    "@destaworks/contracts": "workspace:*",
    "@destaworks/db": "workspace:*",
    "@destaworks/domain": "workspace:*",
    "@destaworks/eslint-config": "workspace:*",
    "@destaworks/prettier-config": "workspace:*",
    "@destaworks/tsconfig": "workspace:*",
    "@destaworks/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "next": "catalog:",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
