{
  "name": "desta-ats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev apps/web",
    "build": "turbo run //#app:build",
    "start": "next start apps/web",
    "lint": "turbo run //#app:lint",
    "typecheck": "turbo run //#app:typecheck",
    "test": "turbo run //#app:test",
    "deps:check": "turbo run //#app:deps-check",
    "app:build": "next build apps/web",
    "app:lint": "eslint .",
    "app:typecheck": "tsc --noEmit",
    "app:test": "vitest run",
    "app:deps-check": "node scripts/check-dependency-drift.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-owner.ts",
    "db:seed:clients": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-clients.ts",
    "db:seed:rules": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-rules.ts",
    "db:seed:demo": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-demo.ts",
    "db:status": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-status.ts",
    "setup:storage": "tsx scripts/setup-storage.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/openai": "^4.0.7",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@destaworks/application": "workspace:*",
    "@destaworks/auth": "workspace:*",
    "@destaworks/config": "workspace:*",
    "@destaworks/contracts": "workspace:*",
    "@destaworks/db": "workspace:*",
    "@destaworks/domain": "workspace:*",
    "@destaworks/integrations": "workspace:*",
    "@destaworks/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "ai": "^7.0.14",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "next": "^15.5.23",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@destaworks/eslint-config": "workspace:*",
    "@destaworks/prettier-config": "workspace:*",
    "@destaworks/tsconfig": "workspace:*",
    "@destaworks/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
