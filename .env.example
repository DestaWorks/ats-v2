# DestaHealth ATS — environment variables (example).
# Copy to `.env` for local dev. NEVER commit real secrets (NDA-binding).
# A DISTINCT set of values exists per environment: local · staging · production (DECISIONS D6).

# --- App ---
# The environment's own origin. Local: http://localhost:3000
# Staging: https://staging.zyx.com  ·  Production: https://zyx.com
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""            # openssl rand -base64 32

# The Desta Works platform hub the "← All Platforms" link on the sign-in / gate screens points at.
# UNSET (or unparseable as a URL) → NO link is rendered at all, never a dead one. It was hardcoded
# to one person's GitHub Pages site until 2026-08-31; it is deployment configuration, since each
# environment points at a different hub or at none. NEXT_PUBLIC_ because the shell renders inside a
# client component; a public hub address is not a secret.
NEXT_PUBLIC_PLATFORM_HUB_URL=""

# --- Database (Supabase Postgres) — separate project per env (staging vs prod) ---
# DATABASE_URL: runtime connections, via Supabase's TRANSACTION pooler (port 6543).
# DIRECT_URL: migrations AND the job queue, via the SESSION pooler (port 5432) — the transaction
# pooler doesn't support the prepared statements migrations need, and it cannot hold the
# LISTEN/NOTIFY session pg-boss depends on (the queue would accept jobs and never fire).
DATABASE_URL=""                  # postgres://...  (staging or prod, never shared)
DIRECT_URL=""                    # postgres://...  (same project, session-pooler port 5432)

# --- Job queue (pg-boss, on the same Postgres) ---
# Each role opens its OWN pool, separate from Prisma's DB_POOL_MAX. Sized small on purpose: the
# ceiling that matters is Supabase's max client connections, and it is shared with every API
# instance. Raise only after confirming headroom there.
# JOBS_WORKER_POOL_MAX="4"       # the worker process (`pnpm start:worker`); 1 is the NOTIFY listener
# JOBS_SENDER_POOL_MAX="2"       # an API process that only enqueues

# --- Auth: Google OAuth (register redirect URIs for ALL origins: localhost, staging, prod) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (provider-agnostic, server-side only) ---
# The model is a "provider/model" string; swap providers with ONE env var, no code change.
# Supported providers: anthropic · openai · google (gemini). Set the key for whichever you use.
AI_MODEL="anthropic/claude-opus-4-8"   # e.g. openai/gpt-5, google/gemini-2.5-pro
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Tried once if AI_MODEL fails. Unset by default — no fallback.
# AI_MODEL_FALLBACK="openai/gpt-5"
# Kill switch — disables all AI features regardless of key presence.
# AI_DISABLED="true"

# --- Client Discovery: contact enrichment (activate-by-key) ---
# Apollo.io (primary) and Hunter.io (fallback when Apollo has no result) look up contacts at a
# prospect practice. UNSET → the enrich buttons return a clear "not configured" error; NPPES
# search + manual pipeline tracking work fully without either key.
APOLLO_API_KEY=""
HUNTER_API_KEY=""

# --- Field encryption for PHI at rest (activate-by-key) ---
# AES-256-GCM key (base64, 32 bytes) for encrypting sensitive columns (licenseNumber, resume
# extractedText/extractedData) at the repository boundary. UNSET → fields are stored as plaintext
# (dev/demo, identical to today). Set it in staging/prod to encrypt all NEW writes; existing
# plaintext rows keep reading and are encrypted the next time they're written.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# --- Object storage (Wave 6) — activate-by-key, provider-agnostic (S3 protocol) ---
# UNSET → avatar upload and resume file storage return a clear "not configured" error; every
# other feature (including resume text extraction) works fully without it. Speaks the standard S3
# protocol, so any S3-compatible provider works with no code change — Supabase Storage's own
# S3-compatible endpoint today, or real AWS S3 / Cloudflare R2 / Backblaze B2 / self-hosted MinIO
# later, just by changing these values. Set all four, then run `pnpm setup:storage` once to create
# the two buckets (avatars public, resumes private).
#
# Supabase setup (verified live 2026-08-10):
# - S3 access keys: Project Settings → Storage → S3 Connection → "New access key". The Endpoint
#   shown there uses the newer `<project-ref>.storage.supabase.co` domain, NOT the classic
#   `<project-ref>.supabase.co` — use exactly what the dashboard shows for S3_ENDPOINT/S3_REGION.
# - S3_PUBLIC_URL_BASE is DIFFERENT from the S3 endpoint domain — it's Supabase's own Storage REST
#   API (not the S3-compatible layer), always `https://<project-ref>.supabase.co/storage/v1/object/public`.
# - GOTCHA: after `pnpm setup:storage` creates the buckets, you MUST manually mark `avatars` public
#   and confirm `resumes` stays private, via Storage → the bucket → "Edit bucket" (buckets created
#   through the S3 API have no public/private flag in the S3 protocol itself, so they land on
#   Supabase's default). The toggle did NOT persist on the first attempt in testing — after saving,
#   hard-refresh the bucket list and confirm the PUBLIC badge actually shows/doesn't show before
#   trusting it; don't assume the first save took.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""

# --- Error tracking (Sentry) — activate-by-key ---
# UNSET → instrumentation.ts / instrumentation-client.ts are both full no-ops; nothing changes.
# ONE DSN covers browser + server + edge (a Sentry DSN is a write-only ingest key, safe to expose
# — unlike the other keys in this file, it is NOT a secret, hence the NEXT_PUBLIC_ prefix). Every
# event/breadcrumb is scrubbed of PII/PHI before it leaves the process — see
# src/lib/monitoring/sentry-scrub.ts — regardless of these settings.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — only needed to upload source maps at build time (readable stack traces in the Sentry
# UI instead of minified ones). Missing any of these three just skips the upload with a warning;
# it never fails the build.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Rate limiting (Upstash Redis) — activate-by-key ---
# UNSET → server/http/rate-limit.ts falls back to an in-memory, per-instance limiter (fine for
# local dev; does NOT coordinate across serverless instances/regions in staging/prod). Set both to
# get a real, shared, cross-instance limit for expensive endpoints (LLM extraction, ETL commit)
# and public flood surfaces (access requests). From the Upstash console: create a Redis database,
# then Project → REST API → copy the URL/token shown there (the REST API, not the Redis protocol
# connection string). Sign-in brute force is separate — that's Better Auth's own rateLimit config
# in server/auth/auth.ts, unaffected by this.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Platform-admin plane (SAAS-RESTRUCTURE-PLAN 6.8) — activate-by-list ---
# UNSET → the plane does not exist: every /platform/* call is refused, including one made by a
# tenant Owner. This is the DIFFERENT AXIS from a tenant role: nothing inside the app can add an
# entry here, which is precisely why it is deployment configuration and not a database table.
# Comma-separated USER IDS (the `user.id` cuid), never emails — a tenant Admin holds `manageUsers`
# and could create an account at any email address, so an email allowlist would be an escalation
# path out of a tenant. Ids are minted by the database and cannot be chosen.
# Read one with: SELECT id FROM "user" WHERE email = '…';
PLATFORM_ADMIN_USER_IDS=""

# Where the platform-admin console (apps/admin) reaches the API. Server-side only — deliberately
# NOT `NEXT_PUBLIC_`, so the console's browser bundle never learns the API's address.
PLATFORM_API_URL="http://localhost:3004"

# Where apps/web's SERVER-rendered pages reach apps/api. Server-side only, never NEXT_PUBLIC_.
# Unset means every ported page throws INTERNAL rather than silently reading in-process.
API_URL="http://localhost:3004"

# Where the BROWSER reaches apps/api. Public by necessity — it ends up in the client bundle — so
# apps/api must treat every request from it as untrusted and authenticate the cookie server-side.
# Unset or empty keeps every browser call relative to apps/web, exactly as before the cutover, so
# this is the switch that moves browser traffic to the API. `/api/auth/*` ignores it either way:
# Better Auth is mounted inside apps/web. Setting it also requires this origin in WEB_ORIGINS below.
NEXT_PUBLIC_API_URL="http://localhost:3004"

# apps/api only: comma-separated browser origins allowed to call it WITH credentials. An allowlist,
# never "*" and never a reflected origin — the session is a cookie, so reflecting it would let any
# site a signed-in user visits read this API as them.
WEB_ORIGINS="http://localhost:3003"
